NEXT_PUBLIC_APP_ENV=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API server base URL (used by better-auth for OAuth callbacks)
API_BASE_URL=http://localhost:3001

# Frontend URL (used by API for redirects after auth, invitations, etc.)
APP_FRONTEND_URL=http://localhost:3000

# Cookie domain for cross-subdomain auth (production only, e.g. .tudominio.com)
AUTH_COOKIE_DOMAIN=

# Trusted origins for CORS (comma-separated, e.g. https://links.tudominio.com,https://api.tudominio.com)
TRUSTED_ORIGINS=

# A 32 byte key used to encrypt and decrypt data
ENCRYPTION_KEY=

# Tinybird - Used for analytics
NEXT_PUBLIC_TINYBIRD_TRACKER_TOKEN=

# Resend - Used for emails
RESEND_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# AWS - Used for uploading assets to S3
